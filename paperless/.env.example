# Paperless-ngx - eigener Docker-Compose-Stack, siehe README.md und ../INSTALL.md Abschnitt 9.
# Komplett getrennt von der .env der Vereinsverwaltung (eigene Datenbank, eigene Geheimnisse).

# --- Pflicht ---
# Langer Zufallsstring fuer Sessions/Signierung. Erzeugen mit: openssl rand -base64 48
PAPERLESS_SECRET_KEY=bitte-lange-zufaellige-zeichenfolge-setzen
# Passwort fuer die Paperless-eigene Postgres-Datenbank (nicht die der Vereinsverwaltung).
POSTGRES_PASSWORD=bitte-aendern

# --- Erster Benutzer (wird nur beim allerersten Start angelegt) ---
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=bitte-aendern
PAPERLESS_ADMIN_MAIL=admin@example.org

# --- Betrieb ---
# Oeffentliche Adresse (siehe ../INSTALL.md Abschnitt 6) - setzt automatisch ALLOWED_HOSTS, CORS und
# CSRF_TRUSTED_ORIGINS passend. Leer lassen, solange nur lokal unter 127.0.0.1:10000 getestet wird.
PAPERLESS_URL=https://paperless.example.org
PAPERLESS_TIME_ZONE=Europe/Berlin
# Hauptsprache fuer die Texterkennung (OCR) gescannter Dokumente.
PAPERLESS_OCR_LANGUAGE=deu
