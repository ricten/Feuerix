# --- Pflicht ---
SECRET_KEY=bitte-lange-zufaellige-zeichenfolge-setzen
# Schluessel fuer verschluesselte Felder (IBAN etc.). Erzeugen mit:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ACHTUNG: Schluessel sichern! Ohne ihn sind die verschluesselten Daten nicht mehr lesbar.
FIELD_ENCRYPTION_KEY=
POSTGRES_PASSWORD=bitte-aendern

# --- Betrieb ---
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# 1 setzen, sobald die Anwendung hinter HTTPS (Reverse Proxy) laeuft
HTTPS=0
WEB_PORT=8000
POSTGRES_DB=vereinsverwaltung
POSTGRES_USER=verein

# --- Domains & HTTPS (Reverse Proxy, siehe INSTALL.md) ---
VEREIN_DOMAIN=verein.example.org
ACME_EMAIL=admin@example.org
# Beide optional und unabhaengig voneinander - leer lassen, wenn nicht genutzt (der jeweilige Domain-Block
# im Reverse Proxy entfaellt dann automatisch):
# OPENSLIDES_DOMAIN: nur setzen, wenn OpenSlides mitbetrieben wird (siehe openslides/).
# PAPERLESS_DOMAIN: nur setzen, wenn Paperless-ngx per Docker Compose mitbetrieben wird (siehe paperless/) oder
#   eine separate Paperless-Instanz genutzt wird.
OPENSLIDES_DOMAIN=
PAPERLESS_DOMAIN=

# Eigenes TLS-Zertifikat statt automatischem Let's Encrypt (optional).
# Leer lassen = automatisches Let's-Encrypt-Zertifikat (Standard, keine Einrichtung noetig).
# Zum Hinterlegen eines eigenen Zertifikats: Dateien unter deploy/certs/ ablegen (siehe
# deploy/certs/README.md) und hier nur den Dateinamen eintragen, z. B.:
# VEREIN_TLS_CERT=verein.crt
# VEREIN_TLS_KEY=verein.key
VEREIN_TLS_CERT=
VEREIN_TLS_KEY=
OPENSLIDES_TLS_CERT=
OPENSLIDES_TLS_KEY=
PAPERLESS_TLS_CERT=
PAPERLESS_TLS_KEY=

# --- Erst-Einrichtung (wird nur beim allerersten Start ausgewertet) ---
ADMIN_USER=admin
ADMIN_PASSWORD=bitte-aendern
ADMIN_EMAIL=
VEREIN_NAME=Mein Verein e.V.

# --- E-Mail-Versand (Rechnungen) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=verein@example.org

# --- FinTS (experimentell) ---
FINTS_PRODUCT_ID=
